# App env (bundled into the client). Only EXPO_PUBLIC_* values belong here.
# Never put a service-role key or any API secret in this file.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Scripts only (npm run eval:chat), never read by the app. The same key lives in Supabase as CHATGPT_KEY.
CHATGPT_KEY=
