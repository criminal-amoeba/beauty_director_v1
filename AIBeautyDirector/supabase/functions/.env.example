# Edge Function secrets. Copy to supabase/functions/.env (gitignored), fill in, then:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real values and never prefix them with EXPO_PUBLIC_.

# Labspace SMS API key (sms.labspace.com.tw → API keys). Used only by send-sms.
LABSPACE_SMS_API_KEY=
# Supabase → Authentication → Hooks → Send SMS → "Generate secret" (looks like v1,whsec_...).
SEND_SMS_HOOK_SECRET=

# DermIQ (run-weekly-scan, camera-test). mock = documented sample, no credits spent. Only `real` calls the API.
DERMIQ_MODE=mock
DERMIQ_API_URL=https://dev.dermiq.cloud
DERMIQ_API_KEY=
# quick = scores only (default, we never download masks); full = with masks. Both cost 1 credit.
DERMIQ_ENDPOINT=quick
# DermIQ returns no model version; this value is stored on every scan and gates trend comparability.
DERMIQ_MODEL_VERSION=dermiq-dev-2026-10

# LLM for the weekly review (run-weekly-scan). mock = fixed safe text, no key needed. real = OpenAI Chat Completions.
LLM_MODE=mock
LLM_PROVIDER=openai
# Falls back to the existing CHATGPT_KEY secret when unset.
LLM_API_KEY=
LLM_MODEL_REVIEW=gpt-5-nano

# Dev-only Camera Test function. Set to true on the dev project only; prod returns 403 `disabled`.
CAMERA_TEST_ENABLED=false
# Logs the raw DermIQ result (no PII) so one real sample can be read back from the function logs. Dev only, set briefly.
CAMERA_TEST_LOG_RAW=false
