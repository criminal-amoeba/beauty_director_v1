{
  "expo": {
    "name": "AIBeautyDirector",
    "slug": "beauty-director",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aibeautydirector",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "AI Beauty Director uses the camera for your weekly skin scan."
      }
    },
    "android": {
      "package": "com.aibeautydirector.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#181311"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#B35A50"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58560325-009c-4541-8753-13380e2f035a"
      }
    },
    "owner": "alexacks-team"
  }
}
